#!/bin/sh
# Block finishing a merge with 'git commit' (after a conflict or a blocked
# pre-merge-commit). Squash merges don't set MERGE_HEAD, so they pass.
if [ -f "$(git rev-parse --git-path MERGE_HEAD)" ]; then
  cat >&2 <<MSG
pre-commit: merge commits are not allowed in this repo.

Abort and squash instead:
  git merge --abort
  git merge --squash <branch>
  git commit -m "<type>: <description>"
MSG
  exit 1
fi

# Lint staged GDScript (check.py skips addons/). Needs uv, not Godot.
staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.gd')
if [ -n "$staged" ]; then
  # shellcheck disable=SC2086 # file names are snake_case, no spaces
  uv run tools/check.py lint $staged || {
    echo "pre-commit: fix the lint problems above, then commit again." >&2
    exit 1
  }
fi
