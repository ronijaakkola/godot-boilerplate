[gd_scene format=3]

[ext_resource type="Script" path="res://ui/main_menu/main_menu.gd" id="1_menu"]
[ext_resource type="Theme" path="res://ui/theme.tres" id="2_theme"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_menu")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Items" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(280, 0)
layout_mode = 2

[node name="Title" type="Label" parent="Center/Items"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Jam Game"
horizontal_alignment = 1

[node name="PlayButton" type="Button" parent="Center/Items"]
unique_name_in_owner = true
layout_mode = 2
text = "Play"

[node name="SettingsButton" type="Button" parent="Center/Items"]
unique_name_in_owner = true
layout_mode = 2
text = "Settings"

[node name="QuitButton" type="Button" parent="Center/Items"]
unique_name_in_owner = true
layout_mode = 2
text = "Quit"

[node name="StartOverlay" type="ColorRect" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.75)

[node name="Center" type="CenterContainer" parent="StartOverlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Label" type="Label" parent="StartOverlay/Center"]
layout_mode = 2
text = "Click anywhere to start"

[connection signal="gui_input" from="StartOverlay" to="." method="_on_start_overlay_gui_input"]
[connection signal="pressed" from="Center/Items/PlayButton" to="." method="_on_play_button_pressed"]
[connection signal="pressed" from="Center/Items/SettingsButton" to="." method="_on_settings_button_pressed"]
[connection signal="pressed" from="Center/Items/QuitButton" to="." method="_on_quit_button_pressed"]
