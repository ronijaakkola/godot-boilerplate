[gd_scene format=3]

[ext_resource type="Script" path="res://ui/pause_menu/pause_menu.gd" id="1_pause"]
[ext_resource type="Theme" path="res://ui/theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://ui/settings/settings_menu.tscn" id="3_settings"]

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 10
script = ExtResource("1_pause")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")

[node name="Dim" type="ColorRect" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.5)

[node name="Center" type="CenterContainer" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Items" type="VBoxContainer" parent="Root/Center"]
custom_minimum_size = Vector2(280, 0)
layout_mode = 2

[node name="Title" type="Label" parent="Root/Center/Items"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Paused"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="Root/Center/Items"]
unique_name_in_owner = true
layout_mode = 2
text = "Resume"

[node name="SettingsButton" type="Button" parent="Root/Center/Items"]
unique_name_in_owner = true
layout_mode = 2
text = "Settings"

[node name="MainMenuButton" type="Button" parent="Root/Center/Items"]
unique_name_in_owner = true
layout_mode = 2
text = "Main menu"

[node name="SettingsMenu" parent="Root" instance=ExtResource("3_settings")]
unique_name_in_owner = true
visible = false
layout_mode = 1

[connection signal="pressed" from="Root/Center/Items/ResumeButton" to="." method="_on_resume_button_pressed"]
[connection signal="pressed" from="Root/Center/Items/SettingsButton" to="." method="_on_settings_button_pressed"]
[connection signal="pressed" from="Root/Center/Items/MainMenuButton" to="." method="_on_main_menu_button_pressed"]
